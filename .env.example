# Copy to .env and edit. Never commit real secrets. Values starting with "change-me" are treated as NOT set.
APP_ENV=development
JWT_SECRET=change-me-to-a-long-random-string-32chars-min
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
WEBHOOK_SECRET=change-me-too-16chars-min
# SEED_DEMO_USERS=true        # creates operator/operator123 and viewer/viewer123 -- demos only
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
OLIST_DATA_DIR=./olist_data
DB_PATH=./logistics.db
MAX_UPLOAD_MB=60
# Customer-facing tracking links in notifications:
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Optional notifications (events are always recorded in the outbox; these enable real sending):
# NOTIFY_SMTP_HOST=smtp.example.com
# NOTIFY_SMTP_PORT=587
# NOTIFY_SMTP_USER=...
# NOTIFY_SMTP_PASSWORD=...
# NOTIFY_FROM=logistics@example.com
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/olist     # generic JSON webhook (Zapier / n8n / WhatsApp provider)
# SEASONALITY=true             # Nov/Dec peak-season ETA factors
